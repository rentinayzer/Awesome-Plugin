{
  "name": "pomodoro-timer",
  "displayName": "Pomodoro Timer",
  "description": "Таймер работы и отдыха с уведомлениями и статистикой по дням",
  "version": "0.1.0",
  "publisher": "simpleit",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./src/pomodoroTimer.js",
  "contributes": {
    "commands": [
      { "command": "pomodoro.toggle", "title": "Pomodoro: Старт/стоп" },
      { "command": "pomodoro.showStats", "title": "Pomodoro: Статистика по дням" }
    ],
    "configuration": {
      "title": "Pomodoro Timer",
      "properties": {
        "pomodoro.workMinutes": {
          "type": "number",
          "default": 1,
          "description": "Длительность работы (минуты). Для реального использования: 25"
        },
        "pomodoro.breakMinutes": {
          "type": "number",
          "default": 1,
          "description": "Длительность отдыха (минуты). Для реального использования: 5"
        }
      }
    }
  }
}