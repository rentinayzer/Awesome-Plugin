{
  "name": "coder-timer",
  "displayName": "Coder Timer",
  "description": "Показывает в статус-баре время кодинга за сегодня",
  "version": "0.1.0",
  "publisher": "simpleit",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./src/coderTimer.js",
  "contributes": {
    "commands": [
      { "command": "coderTimer.hello", "title": "Coder Timer: Hello World", "icon": "$(smiley)" },
      { "command": "coderTimer.reset", "title": "Coder Timer: Сбросить таймер" }
    ],
    "menus": {
      "editor/title": [
        { "command": "coderTimer.hello", "group": "navigation" }
      ],
      "editor/context": [
        { "command": "coderTimer.hello", "group": "coderTimer@1" },
        { "command": "coderTimer.reset", "group": "coderTimer@2" }
      ]
    },
    "configuration": {
      "title": "Coder Timer",
      "properties": {
        "coderTimer.userName": {
          "type": "string",
          "default": "Иван Иванов",
          "description": "Имя для сообщения Hello, World!"
        }
      }
    }
  }
}
