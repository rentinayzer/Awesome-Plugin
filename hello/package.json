{
  "name": "hello-toolbar",
  "displayName": "Hello Toolbar",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/hello.js",
  "contributes": {
    "commands": [
      {
        "command": "hello.sayHello",
        "title": "Hello World",
        "icon": "$(smiley)"
      }
    ],
    "menus": {
      "editor/title": [
        { "command": "hello.sayHello", "group": "navigation" }
      ],
      "editor/context": [
        { "command": "hello.sayHello", "group": "hello@1" }
      ],
      "explorer/context": [
        { "command": "hello.sayHello", "group": "hello@1" }
      ]
    },
    "configuration": {
      "title": "Hello Toolbar",
      "properties": {
        "hello.userName": {
          "type": "string",
          "default": "",
          "description": "Ваше имя для сообщения Hello, World!"
        }
      }
    }
  }
}